# Copia este archivo como .env (o usa dart_defines.json, que ya trae los
# valores públicos del proyecto). Son los MISMOS nombres que en Flutter
# (--dart-define / --dart-define-from-file). NUNCA subas un .env real.
#
# Expo los lee al arrancar (`npx expo start`); si cambias el .env, reinicia
# con `npx expo start -c`.

# From the Roble console, project settings.
ROBLE_BASE_URL=https://roble-api.test-openlab.uninorte.edu.co
ROBLE_CONTRACT_ID=movil_flutter_dcaabc5f4e

# Name of the "destino de retorno" registered in the Roble console under
# Usuarios > Proveedores. This is a NAME, not a URL. Used by Microsoft sign-in.
ROBLE_SSO_REDIRECT=innovation-hub-web-dev

# Custom URL scheme of the mobile app, only for Microsoft sign-in on
# Android/iOS (e.g. com.miempresa.miapp). It must be registered as a return
# target in Roble. app.config.ts registers it as the app's scheme.
ROBLE_NATIVE_CALLBACK_SCHEME=

# Domain new self-registrations must belong to. Leave empty to allow any.
INSTITUTIONAL_EMAIL_DOMAIN=uninorte.edu.co

# NOT here, on purpose: the Microsoft Client ID, Client Secret and Tenant ID are
# configured only in the Roble console (Usuarios > Proveedores > Microsoft).
